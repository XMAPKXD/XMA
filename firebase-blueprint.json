{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Categories for XMA Awards with official nominees",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category unique ID" },
        "title": { "type": "string", "description": "Category title" },
        "subtitle": { "type": "string", "description": "Category subtitle" },
        "status": { "type": "string", "description": "Voting status" },
        "order": { "type": "number", "description": "Sort order" },
        "nominees": { "type": "array", "description": "List of nominees" }
      },
      "required": ["id", "title"]
    },
    "CommunityNomination": {
      "title": "CommunityNomination",
      "description": "Community submitted nomination",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Nomination unique ID" },
        "nomineeName": { "type": "string", "description": "Nominee name" },
        "categoryId": { "type": "string", "description": "Category ID" },
        "status": { "type": "string", "description": "Status" }
      },
      "required": ["id", "nomineeName"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories of XMA Awards"
    },
    "/community_nominations/{nominationId}": {
      "schema": "CommunityNomination",
      "description": "Community nominations"
    }
  }
}
